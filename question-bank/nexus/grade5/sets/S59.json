     "choices": [],
     "answer_lines": [
      "Explanation:",
      ""
     ],
     "correct_letter": null,
     "correct_answer": "Multiplying by 1,000 makes each digit worth 1,000 times as much, so each digit moves 3 places to the left; the 3 empty places (hundreds, tens, ones) are filled with zeros.",
     "drawing_answer": null,
     "required_method": null,
     "grading_note": "Must use place value: each factor of 10 moves every digit one place to the left (1,000 = 10 × 10 × 10, so three places) and zeros fill the empty places. \"Just add three zeros\" without the place-value reason is not enough.",
     "figure": null,
     "page": 429,
     "revision": "new"
    },
