   "skill": "Strategy: list the letters with their positions",
   "outcome": "LOGIC.WORD.01",
   "branch_mode": "guided_strategy",
   "relationship": "Students misjudge word patterns by eye. Writing each letter with its position number turns the pattern into something that can be checked one step at a time.",
   "author_note": "Students misjudge word patterns by eye. Writing each letter with its position number turns the pattern into something that can be checked one step at a time.",
   "lesson": {
    "title": "List the letters with their positions",
    "text": [
     "Write the word in capitals with a position number under each letter: 1, 2, 3, ...",
     "For \"alphabetical order\", compare each letter only with the one before it.",
     "For counting, mark each match as you find it, then count the marks.",
     "For first letters or acrostics, write the first letter of each word in order before reading the result."
    ],
    "example": {
     "title": "Worked example (a different word)",
     "prompt": [
      "Is GHOST in alphabetical order? How many times does O appear in COOKBOOK?"
     ],
     "steps": [
      "G(1) H(2) O(3) S(4) T(5): G <= H, H <= O, O <= S, S <= T. Yes, in order.",
      "C O O K B O O K: O at positions 2, 3, 6, 7. O appears 4 times."
     ]
    }
