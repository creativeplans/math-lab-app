     "number": 5,
     "standard": "",
     "domain": "formal logic",
     "type": "mc",
     "prompt": "\"All dragons breathe fire. So some dragons breathe fire.\" When does this follow?",
     "outcome": "LOGIC.SETS.02",
     "choices": [
      {
       "letter": "A",
       "text": "Always: \"all\" includes \"some\"."
      },
      {
       "letter": "B",
       "text": "Only if dragons are real animals."
      },
      {
       "letter": "C",
       "text": "Never: the premise is about all dragons."
      },
      {
       "letter": "D",
       "text": "Only if at least one dragon exists (the existence assumption)."
      }
     ],
     "correct_letter": "D",
     "correct_answer": "Only if at least one dragon exists (the existence assumption)."
