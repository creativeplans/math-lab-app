     "number": 2,
     "standard": "",
     "domain": "formal logic",
     "type": "mc",
     "prompt": "\"All violinists are musicians. All musicians practice. So all violinists practice.\" Is this valid?",
     "outcome": "LOGIC.SETS.02",
     "choices": [
      {
       "letter": "A",
       "text": "No: some violinists may not practice."
      },
      {
       "letter": "B",
       "text": "Yes, but only if every musician is a violinist."
      },
      {
       "letter": "C",
       "text": "Yes: every violinist is inside the musicians, who are all inside those who practice."
      },
      {
       "letter": "D",
       "text": "No: the conclusion reverses a premise."
      }
     ],
     "correct_letter": "C",
     "correct_answer": "Yes: every violinist is inside the musicians, who are all inside those who practice."
    },
    {
